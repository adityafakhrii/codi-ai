# ==============================================================================
# Codi AI - Konfigurasi API LLM Asli
# ==============================================================================

# Kunci API LLM Anda (Wajib diisi)
# Contoh format:
# - OpenAI: sk-proj-...
# - Groq: gsk_...
# - OpenRouter: sk-or-v1-...
# - DeepSeek: sk-...
# - Ollama Lokal: isi sembarang karakter (misal: ollama)
LLM_API_KEY=

# Base URL penyedia API LLM (Kompatibel dengan standar OpenAI API)
# Pilihan populer:
# - OpenAI: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Groq: https://api.groq.com/openai/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Ollama Lokal: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model LLM yang digunakan
# Mendukung multi-model dengan sistem fallback otomatis (dipisahkan koma).
# Jika model pertama sibuk atau error, server akan otomatis beralih ke model berikutnya:
LLM_MODELS=@makers/deepseek-v4.1-flash,@makers/deepseek-v4-flash,@makers/deepseek-v4-pro,@makers/kimi-k2.6,@makers/minimax-m3,@makers/minimax-m2.7,@makers/hy3
LLM_MODEL=@makers/deepseek-v4.1-flash

# Port server web lokal
PORT=3000

